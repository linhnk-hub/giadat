# =============================================================================
# FRONTEND BUILD-TIME VARIABLES (Public — embedded into Vite static bundle)
# Configure in GitHub Repository Settings -> Secrets and variables -> Actions -> Variables
# NEVER put private server secrets into VITE_* variables.
# =============================================================================

# [OPTIONAL locally / REQUIRED when Frontend & Backend are on different domains]
# Public — Base URL of the remote Render Backend (no trailing slash).
# Leave empty for local same-origin development.
VITE_API_BASE_URL=""

# [OPTIONAL] Public — Base path for Vite & SPA routing.
# - Use "/" for User Site, Custom Domain, or local development.
# - Use "/<repo-name>/" for GitHub Pages Project Site.
VITE_BASE_PATH="/"

# =============================================================================
# BACKEND RUNTIME VARIABLES (Server-side only — Render Environment Variables)
# =============================================================================

# [REQUIRED in production] Non-secret — Set to "production" on Render.
NODE_ENV="development"

# [OPTIONAL locally / AUTO-INJECTED on Render] Non-secret — Listening HTTP port.
PORT="3000"

# [REQUIRED on Render Persistent Disk / OPTIONAL locally] Non-secret —
# Absolute path to the JSON dataset store file on persistent storage.
# Example on Render Persistent Disk mounted at /var/data:
# DATA_STORE_PATH="/var/data/datasets-store.json"
DATA_STORE_PATH=""

# [REQUIRED when Frontend & Backend are on different domains] Non-secret —
# Comma-separated exact allowed browser origins (scheme://host[:port]).
# Do NOT include paths (/admin, /api), trailing slashes, or wildcards (*).
# Example: CORS_ALLOWED_ORIGINS="https://your-username.github.io"
CORS_ALLOWED_ORIGINS=""

# [OPTIONAL — defaults to built-in fixed admin email if omitted] Sensitive —
# Single Fixed Admin Email (A1). Must be exactly one valid email address.
# If set to empty/whitespace/invalid format, Backend fails closed (HTTP 503).
# ADMIN_EMAIL="admin@example.com"

# [OPTIONAL — falls back to firebase-applet-config.json] Non-secret —
# Firebase Project ID used by firebase-admin to verify ID token issuer & audience.
FIREBASE_PROJECT_ID=""

# [REQUIRED for GeoSnapCamera OCR (/api/analyze-photo)] SECRET —
# Server-side Gemini API key. Keep strictly on the Backend; never expose to Frontend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# [OPTIONAL] Non-secret — Set to "false" for Backend-only deployments (e.g. Render)
# so Express skips serving dist/index.html and returns clean JSON 404 for unknown routes.
SERVE_STATIC="true"
